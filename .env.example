# Copy to .env for local use (never commit .env). On Render, set these in the dashboard instead.
ADMIN_USER=admin
ADMIN_PASSWORD=choose-a-long-random-password
# Leave unset to store data in local files (data/ and public/images/uploads/).
# Set to your Neon connection string to store everything in Postgres:
# DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
